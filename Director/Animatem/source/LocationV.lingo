-- Location Vertical

--  Note: For best results set the Tempo to 1 fps.


property pSpr_Mine                     --  Sprite used by this channel
property pLocationV                    --  Vertical location

global gObj_Animate


on getBehaviorDescription me
  
  return("Set the vertical location.")
  
end


on getPropertyDescriptionList me
  
  set description = [:]
  
  addProp(description, #pLocationV, [#default: 240,¬
                                      #format: #integer,¬
                                     #comment: "Vertical Location:"])
  
  return(description)
  
end


on beginSprite me
  
  set pSpr_Mine = the spriteNum of me
  
  -- Ensure that the animation engine is present, if not then make it.
  if not gObj_Animate then set gObj_Animate = new(script "ancestor script for animate")
  
  -- set property
  setProperty(gObj_Animate, pSpr_Mine, [#active : #Activate,¬
                                          #locV : pLocationV])
  
end







