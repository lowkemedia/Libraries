global gObj_Animate


on deactivated mSprite
  --
  -- called automatically when 'mSprite' is deactivated
  
end


on endCycle mSprite
  --
  -- called automatically when 'mSprite' finishes a cycle type #end
  
end


on atDestination mSprite
  --
  -- called when sprite reaches its destination
  
  setProperty(gObj_Animate, mSprite, [#active: FALSE])
  
end


on handleCollision sourceSprite, targetSprite, sourceBehaviour
  --
  -- called when sourceSprite has collided with targetSprite
  -- a sourceBehaviour is passed also
  
  case sourceBehaviour of
      
      -- YOUR CALLS HERE!
      
    #warp:
      set x = random(640)
      set y = random(480)
      setProperty(gObj_Animate, targetSprite, [#location : point (x,y)])

  end case
  
end