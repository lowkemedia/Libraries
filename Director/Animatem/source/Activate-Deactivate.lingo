-- Activate/Deactivate

--  Note: For best results set the Tempo to 1 fps.


property pSpr_Mine      --  Sprite used by this channel
property pType          --  Type of activation
property pHide          --  If TRUE then sprite is hidden on deactivate

global gObj_Animate


on getBehaviorDescription me
  
  return("Activate or deactivate this channel.")
  
end


on getPropertyDescriptionList me
  
  set description = [:]
  
  addProp(description, #pType, [#default: #initialize,¬
                                 #format: #symbol,¬
                                #comment: "Type of Activation:",¬
                                  #range: [#initialize, #activate, #deactivate, #pause]])
  
  addProp(description, #pHide, [#default: TRUE,¬
                                 #format: #boolean,¬
                                #comment: "Hide on deactivate:"])
  
  return(description)
  
end


on beginSprite me
  
  set pSpr_Mine = the spriteNum of me
  puppetSprite(pSpr_Mine, TRUE)
  
  -- Ensure that the animation engine is present, if not then make it.
  if not gObj_Animate then set gObj_Animate = new(script "ancestor script for animate")
  
  -- set property
  setProperty(gObj_Animate, pSpr_Mine, [#remove : pHide, #active : pType])
  
end




